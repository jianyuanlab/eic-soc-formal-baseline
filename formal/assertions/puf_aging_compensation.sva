// EIC-SPEC-05: PUF Multi-Stress Dynamic Drift Calibration Invariant
module puf_aging_compensation (
    input logic clk,
    input logic rst_n,
    input logic puf_auth_request,
    // 0.1°C resolution signed temperature: -40.0°C (-400) to +150.0°C (+1500)
    input logic signed [11:0] junction_temperature,
    input logic calib_matrix_applied,
    input logic key_reconstruct_success,
    input logic ber_violation_alarm
);

    // SIG-GATE-08: Full automotive envelope (-40°C to +150°C) drift convergence
    property p_puf_drift_calibration;
        @(posedge clk) disable iff (!rst_n)
        ($rose(puf_auth_request) && 
         (junction_temperature >= -12'sd400) && 
         (junction_temperature <= 12'sd1500))
        |-> ##[2:8] ($sampled(calib_matrix_applied) && $sampled(key_reconstruct_success) && !$sampled(ber_violation_alarm));
    endproperty

    assert_puf_calibration: assert property (p_puf_drift_calibration)
        else $error("[FATAL][SIG-GATE-08] PUF fuzzy extractor key reconstruction failed under environmental stress!");

endmodule
